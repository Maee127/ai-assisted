# Meta / Instagram webhook
META_APP_SECRET=replace_with_meta_app_secret
WEBHOOK_VERIFY_TOKEN=replace_with_webhook_verify_token
IG_BUSINESS_ACCOUNT_ID=replace_with_instagram_business_account_id
MAX_WEBHOOK_PAYLOAD_BYTES=1048576

# Anthropic classification
ANTHROPIC_API_KEY=replace_with_anthropic_api_key
PRIMARY_CLASSIFIER_MODEL=claude-haiku-4-5-20251001
STRONGER_CLASSIFIER_MODEL=claude-sonnet-5
CLASSIFICATION_PROMPT_VERSION=classification-v1
CLASSIFICATION_MAX_TOKENS=256

# Local application settings
DB_PATH=./data/leads.db
PORT=3000
